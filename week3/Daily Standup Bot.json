        "jsCode": "const items = $input.all();\nconst commits = items.map(item => {\n  const c = item.json;\n  return `- ${c.commit?.message?.split('\\n')[0] || 'No message'} (${c.sha?.substring(0,7)})`;\n}).join('\\n') || '- No commits found';\n\nconst fullPrompt = \"You are a standup assistant. Write a daily standup with Yesterday/Today/Blockers sections based on these GitHub commits:\\n\\n\" + commits;\n\nreturn [{ json: { fullPrompt, commits } }];"
